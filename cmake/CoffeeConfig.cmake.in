@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/CoffeeTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CoffeeHelpers.cmake")

# SDL, GLAD, and stb_image are implementation details of Coffee.dll. Vulkan
# is discovered only when a consumer explicitly requests the companion module:
# find_package(Coffee CONFIG REQUIRED COMPONENTS Vulkan)
if("Vulkan" IN_LIST Coffee_FIND_COMPONENTS)
    if(@COFFEE_HAS_VULKAN_MODULE@ AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/CoffeeVulkanTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(Vulkan)
        include("${CMAKE_CURRENT_LIST_DIR}/CoffeeVulkanTargets.cmake")
        set(Coffee_Vulkan_FOUND TRUE)
    else()
        set(Coffee_Vulkan_FOUND FALSE)
    endif()
endif()

check_required_components(Coffee)
